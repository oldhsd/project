# Required. Use a dedicated MongoDB database and a least-privilege database user.
MONGODB_URI=mongodb://127.0.0.1:27017/buildnext
# Generate a unique random secret. Do not reuse development secrets in production.
AUTH_SECRET=
# Exact public origin, including HTTPS in production. No trailing slash.
AUTH_URL=http://localhost:3000
# Enable only behind a trusted reverse proxy or for local development.
AUTH_TRUST_HOST=true
# Enable only when your edge proxy overwrites X-Forwarded-For (never trusts client values).
TRUST_PROXY=false
# ADMIN_EMAIL, ADMIN_NAME and ADMIN_PASSWORD are operator-supplied only for db:bootstrap.
# Never expose these as NEXT_PUBLIC_ variables or retain them in deployment configuration.
